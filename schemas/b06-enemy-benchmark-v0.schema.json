{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:veilbound:schema:b06-benchmark-enemy-v0",
  "title": "Veilbound B06 Enemy / Creature Benchmark Fixture v0",
  "description": "Design/test-only executable combatant schema. Nonhuman, non-archetype, beast, undead, dragon and Pillar-manifested creatures are permitted when each mechanic has independent authored authority. Draft bestiary concepts use the separate B06 bestiary-index schema and may not pretend to possess executable attack math.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "benchmark_level",
    "rules_basis",
    "identity",
    "abilities",
    "defenses",
    "resources",
    "equipment",
    "effects",
    "attack_profiles",
    "tactics",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "b06-enemy-v0"
    },
    "id": {
      "type": "string",
      "pattern": "^B06-EN-[0-9]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DESIGN_FIXTURE_ONLY",
        "EXECUTABLE_TEST_FIXTURE",
        "CANONICAL_CONTENT"
      ]
    },
    "benchmark_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "rules_basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "archetype",
        "focus",
        "pillar",
        "focus_feature_notes"
      ],
      "properties": {
        "type": {
          "enum": [
            "player_rules_derived_opponent",
            "ordinary_non_archetype_humanoid",
            "authored_creature",
            "raised_undead",
            "turned_undead",
            "pillar_manifestation",
            "nonphysical_spirit"
          ]
        },
        "archetype": {
          "type": [
            "string",
            "null"
          ]
        },
        "focus": {
          "type": [
            "string",
            "null"
          ]
        },
        "pillar": {
          "type": [
            "string",
            "null"
          ]
        },
        "focus_feature_notes": {
          "type": "string"
        }
      }
    },
    "abilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "agility",
        "precision",
        "intelligence",
        "awareness",
        "presence",
        "vitality",
        "veil_affinity",
        "veil_control"
      ],
      "properties": {
        "strength": {
          "type": "integer",
          "minimum": -2,
          "maximum": 20
        },
        "agility": {
          "type": "integer",
          "minimum": -2,
          "maximum": 20
        },
        "precision": {
          "type": "integer",
          "minimum": -2,
          "maximum": 20
        },
        "intelligence": {
          "type": "integer",
          "minimum": -2,
          "maximum": 20
        },
        "awareness": {
          "type": "integer",
          "minimum": -2,
          "maximum": 20
        },
        "presence": {
          "type": "integer",
          "minimum": -2,
          "maximum": 20
        },
        "vitality": {
          "type": "integer",
          "minimum": -2,
          "maximum": 20
        },
        "veil_affinity": {
          "type": "integer",
          "minimum": -2,
          "maximum": 20
        },
        "veil_control": {
          "type": "integer",
          "minimum": -2,
          "maximum": 20
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weapon_training",
        "learned_disciplines",
        "talents",
        "prepared_techniques",
        "chosen_devotion"
      ],
      "properties": {
        "weapon_training": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "learned_disciplines": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          }
        },
        "talents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "prepared_techniques": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "chosen_devotion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "Mandatory for player-rules-derived opponents. Optional for independently authored creature/NPC combatants; no empty or invented Priest/Scholar/Gifted/Anointed progression is needed for beasts or ordinary non-Archetype humans."
    },
    "defenses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp_max",
        "vigor_max",
        "armor",
        "armor_name",
        "dodge_agility_cap",
        "dodge_base",
        "guard_instrument",
        "guard_base",
        "guard_capacity",
        "initiative_bonus",
        "resistance_notes"
      ],
      "properties": {
        "hp_max": {
          "type": "integer",
          "minimum": 1
        },
        "vigor_max": {
          "type": "integer",
          "minimum": 0
        },
        "armor": {
          "type": "integer",
          "minimum": 0
        },
        "armor_name": {
          "type": "string"
        },
        "dodge_agility_cap": {
          "type": [
            "integer",
            "null"
          ]
        },
        "dodge_base": {
          "type": "integer"
        },
        "guard_instrument": {
          "type": [
            "string",
            "null"
          ]
        },
        "guard_base": {
          "type": [
            "integer",
            "null"
          ]
        },
        "guard_capacity": {
          "type": "integer",
          "minimum": 0
        },
        "initiative_bonus": {
          "type": "integer"
        },
        "resistance_notes": {
          "type": "string"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_ap",
        "physical_action_ap",
        "projection_action_ap",
        "movement_points",
        "max_vp",
        "natural_regeneration_throughput",
        "reaction_capacity",
        "start_states"
      ],
      "properties": {
        "turn_ap": {
          "type": "integer",
          "minimum": 1
        },
        "physical_action_ap": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "null when no generic Physical Action price is authored; any executable creature attack must still declare and justify its own actual AP/action cost."
        },
        "projection_action_ap": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "null means no personal executable Projection Action authorization (e.g. ordinary uninvoking human or noncasting creature). Never infer a Focus or castable technique from this field."
        },
        "movement_points": {
          "type": "integer",
          "minimum": 0
        },
        "max_vp": {
          "type": "integer",
          "minimum": 0
        },
        "natural_regeneration_throughput": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "null when natural biological regeneration is inapplicable/unauthored; 0 is an authored zero-throughput state, not a universal undead rule."
        },
        "reaction_capacity": {
          "type": "integer",
          "minimum": 0
        },
        "start_states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "available_vp",
              "committed_vp",
              "spent_vp",
              "hp",
              "vigor",
              "active_effects",
              "condition"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "available_vp": {
                "type": "integer",
                "minimum": 0
              },
              "committed_vp": {
                "type": "integer",
                "minimum": 0
              },
              "spent_vp": {
                "type": "integer",
                "minimum": 0
              },
              "hp": {
                "type": "integer"
              },
              "vigor": {
                "type": "integer",
                "minimum": 0
              },
              "active_effects": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "condition": {
                "type": "string"
              }
            }
          }
        }
      },
      "description": "Executable creature must have authored HP/Vigor/AP/VP including VP=0 and 0 projection when unavailable. No automatic player Focus AP or Regeneration formula for non-Archetype creatures."
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "cost_sp",
          "equipped"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cost_sp": {
            "type": "integer",
            "minimum": 0
          },
          "equipped": {
            "type": "boolean"
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_technique",
          "profile",
          "used_tier",
          "activation_ap",
          "effective_committed_vp",
          "establishment_spent_vp",
          "required_anchor",
          "ending_condition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source_technique": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "used_tier": {
            "type": "integer",
            "minimum": 1
          },
          "activation_ap": {
            "type": "integer",
            "minimum": 0
          },
          "effective_committed_vp": {
            "type": "integer",
            "minimum": 0
          },
          "establishment_spent_vp": {
            "type": "integer",
            "minimum": 0
          },
          "required_anchor": {
            "type": "string"
          },
          "ending_condition": {
            "type": "string"
          }
        }
      }
    },
    "attack_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attack"
      },
      "description": "Only fully sourced executable attack and ability profiles. Unauthored breath, bite, venom, stinger, non-physical contact or natural action math belongs in bestiary planned_capabilities, not this list."
    },
    "tactics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_policy",
        "defense_policy",
        "scenario_constraints"
      ],
      "properties": {
        "action_policy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defense_policy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scenario_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula_checks",
        "known_exclusions",
        "certification_status"
      ],
      "properties": {
        "formula_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "certification_status": {
          "type": "string"
        }
      }
    },
    "bestiary_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^B06-EN-[0-9]{2}$",
      "description": "Optional link to the provisional bestiary entry; absent in legacy fixtures."
    },
    "creature_profile": {
      "$ref": "#/$defs/creatureProfile"
    }
  },
  "$defs": {
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "damage_type",
        "fixed_base",
        "die",
        "strength_contribution",
        "armor_penetration",
        "mitigation",
        "source"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hp",
            "vigor"
          ]
        },
        "damage_type": {
          "type": "string"
        },
        "fixed_base": {
          "type": "integer",
          "minimum": 0
        },
        "die": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "d4",
            "d6",
            "d8",
            "d10",
            "d12",
            "d20",
            null
          ]
        },
        "strength_contribution": {
          "enum": [
            "none",
            "light",
            "full"
          ]
        },
        "armor_penetration": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "mitigation": {
          "enum": [
            "physical_armor_after_penetration",
            "fire_resistance",
            "none"
          ]
        },
        "source": {
          "type": "string"
        },
        "extra_formula": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "operator",
            "die",
            "multiplier",
            "divisor",
            "vc_bonus"
          ],
          "properties": {
            "operator": {
              "const": "ceil_div_dice"
            },
            "die": {
              "enum": [
                "d4",
                "d6",
                "d8"
              ]
            },
            "multiplier": {
              "type": "integer",
              "minimum": 1
            },
            "divisor": {
              "type": "integer",
              "minimum": 1
            },
            "vc_bonus": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "action_class",
        "ap",
        "attack_roll",
        "range_class",
        "weapon_or_source",
        "source_class",
        "primary_hp_packet",
        "additional_packets",
        "required_active_effect",
        "requires_effect_inactive",
        "toxin_delivery",
        "critical_notes",
        "legality_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "action_class": {
          "enum": [
            "physical",
            "projection",
            "full",
            "reaction"
          ]
        },
        "ap": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "attack_roll": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "ability_a",
            "ability_b",
            "training_family",
            "effective_training",
            "situational_bonus",
            "total_bonus"
          ],
          "properties": {
            "ability_a": {
              "type": "string"
            },
            "ability_b": {
              "type": "string"
            },
            "training_family": {
              "type": "string"
            },
            "effective_training": {
              "type": "integer"
            },
            "situational_bonus": {
              "type": "integer"
            },
            "total_bonus": {
              "type": "integer"
            }
          },
          "description": "null only when a separately authored non-weapon resolution explicitly does not use an attack roll; include source_authority_ref and resolution_rule_ref."
        },
        "range_class": {
          "enum": [
            "melee",
            "ranged"
          ]
        },
        "weapon_or_source": {
          "type": "string"
        },
        "primary_hp_packet": {
          "anyOf": [
            {
              "$ref": "#/$defs/packet"
            },
            {
              "type": "null"
            }
          ],
          "description": "null only for independently authored no-primary-HP resolutions; do not fabricate an attack or critical packet for a supernatural or non-damaging effect."
        },
        "additional_packets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packet"
          }
        },
        "required_active_effect": {
          "type": [
            "string",
            "null"
          ]
        },
        "requires_effect_inactive": {
          "type": [
            "string",
            "null"
          ]
        },
        "toxin_delivery": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "profile_id",
            "route",
            "explicit_source",
            "requires_surviving_puncture"
          ],
          "properties": {
            "profile_id": {
              "type": "string"
            },
            "route": {
              "enum": [
                "injection",
                "contact",
                "ingestion",
                "inhalation"
              ]
            },
            "explicit_source": {
              "type": "string",
              "minLength": 1
            },
            "requires_surviving_puncture": {
              "type": "boolean"
            },
            "source_ref": {
              "type": "string",
              "minLength": 1,
              "description": "Must identify a separately authored physical source capable of the route, not just the toxin catalogue."
            }
          },
          "allOf": [
            {
              "if": {
                "type": "object"
              },
              "then": {
                "required": [
                  "source_ref"
                ]
              }
            }
          ]
        },
        "critical_notes": {
          "type": "string"
        },
        "legality_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "source_class": {
          "enum": [
            "mundane_weapon",
            "natural_weapon",
            "learned_veil",
            "innate_veil",
            "breath",
            "environment",
            "other"
          ],
          "description": "Required source category on EVERY executable attack. Natural, innate, breath, environment and other origins additionally require source_authority_ref and resolution_rule_ref. A missing category is invalid, even for rolled attacks with a non-null HP packet."
        },
        "resolution_kind": {
          "enum": [
            "ordinary_weapon_attack",
            "authored_natural_attack",
            "authored_veil_attack",
            "authored_breath_area",
            "authored_non_damage_effect",
            "other"
          ],
          "description": "Category does not itself authorize or define rolls, sizes, armor handling, area geometry or action economy."
        },
        "source_authority_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical rule or separately authored creature ability needed for natural attack/breath/innate source."
        },
        "target_geometry": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "kind",
            "range_rule_ref"
          ],
          "properties": {
            "kind": {
              "enum": [
                "melee_one",
                "ranged_one",
                "area",
                "self",
                "special"
              ]
            },
            "range_rule_ref": {
              "type": "string",
              "minLength": 1
            },
            "area_rule_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "resolution_rule_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Authoritative resolution rule for an unusual bite, breath, incorporeal effect or unrolled application; absent on existing standard weapon Attack profiles."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attack_roll": {
                "type": "null"
              }
            },
            "required": [
              "attack_roll"
            ]
          },
          "then": {
            "required": [
              "source_authority_ref",
              "resolution_rule_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "primary_hp_packet": {
                "type": "null"
              }
            },
            "required": [
              "primary_hp_packet"
            ]
          },
          "then": {
            "required": [
              "source_authority_ref",
              "resolution_rule_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source_class": {
                "enum": [
                  "natural_weapon",
                  "innate_veil",
                  "breath",
                  "environment",
                  "other"
                ]
              }
            },
            "required": [
              "source_class"
            ]
          },
          "then": {
            "required": [
              "source_authority_ref",
              "resolution_rule_ref"
            ]
          }
        }
      ]
    },
    "creatureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "species_or_kind",
        "body_state",
        "cognition",
        "veil_relationship",
        "physical_presence",
        "mvp_player_option",
        "pillar_affinities",
        "physiology_notes",
        "behavior_notes"
      ],
      "properties": {
        "family": {
          "enum": [
            "ordinary_humanoid",
            "archetype_humanoid",
            "natural_beast",
            "veil_touched_beast",
            "dragon",
            "raised_undead",
            "turned_undead",
            "pillar_manifestation",
            "spirit",
            "unknown_species"
          ]
        },
        "species_or_kind": {
          "type": "string",
          "minLength": 1
        },
        "body_state": {
          "enum": [
            "living",
            "corporeal_raised",
            "corporeal_turned",
            "veil_formed",
            "nonphysical_spirit",
            "undetermined"
          ]
        },
        "cognition": {
          "enum": [
            "sapient",
            "animal_like",
            "non_sentient_pattern",
            "undetermined"
          ]
        },
        "veil_relationship": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ordinary_no_independent_invocation",
              "learned_or_bonded_archetype",
              "outward_dominant",
              "inward_dominant",
              "innate_pillar_affinity",
              "veil_touched",
              "corporeal_reanimation",
              "undead_transformation",
              "surge_manifestation",
              "independent_spirit",
              "undetermined"
            ]
          }
        },
        "physical_presence": {
          "enum": [
            "corporeal",
            "nonphysical_no_ordinary_interaction",
            "manifested_conditional",
            "undetermined"
          ]
        },
        "mvp_player_option": {
          "enum": [
            "human_only",
            "not_playable_mvp",
            "not_applicable"
          ]
        },
        "pillar_affinities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pillar",
              "aspect",
              "origin_status"
            ],
            "properties": {
              "pillar": {
                "type": "string",
                "minLength": 1
              },
              "aspect": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "origin_status": {
                "enum": [
                  "canonical_pillar_identity",
                  "example_only",
                  "to_be_authored"
                ]
              }
            }
          }
        },
        "physiology_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "behavior_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape",
            "width_cells",
            "length_cells",
            "reference_rule",
            "movement_rule_ref",
            "rotation_rule_ref",
            "cell_ids",
            "reference_cell_id"
          ],
          "properties": {
            "shape": {
              "enum": [
                "rectangular",
                "irregular"
              ]
            },
            "width_cells": {
              "type": "integer",
              "minimum": 1
            },
            "length_cells": {
              "type": "integer",
              "minimum": 1
            },
            "reference_rule": {
              "type": "string",
              "minLength": 1
            },
            "movement_rule_ref": {
              "type": "string",
              "minLength": 1
            },
            "rotation_rule_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "cell_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "description": "Body-local cell identities, unique and ordered (index 1 is cell_ids[0]). Semantic validator also enforces reference_cell_id membership and rectangular cell-count consistency."
            },
            "reference_cell_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
              "description": "Permanent reference cell identity. MUST be a member of sibling cell_ids; run scripts.validate_b06_footprints to enforce cross-field membership for all B06 documents. It is never selected again by world-coordinate sorting."
            }
          },
          "description": "Optional rigid footprint metadata; multi-square movement and pivot legality follows independently authored rules. No size-derived natural attacks or combat bonuses.",
          "$comment": "SEMANTIC CONSTRAINT (not expressible with standard Draft 2020-12 JSON Schema): reference_cell_id MUST be an element of cell_ids. Run python -m scripts.validate_b06_footprints (as well as schema validation) for every B06 bestiary index and executable enemy fixture. For rectangular footprints, len(cell_ids) must equal width_cells * length_cells."
        }
      }
    },
    "plannedCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source_class",
        "state",
        "concept",
        "missing_authority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^B06-CAP-[A-Z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source_class": {
          "enum": [
            "mundane_weapon",
            "natural_weapon",
            "physiology",
            "innate_veil",
            "learned_veil",
            "magical_item",
            "undead_animation",
            "surge_manifestation",
            "environment",
            "none"
          ]
        },
        "state": {
          "enum": [
            "existing_authority_only",
            "requires_authored_attack_or_effect",
            "narrative_only",
            "deferred"
          ]
        },
        "concept": {
          "type": "string"
        },
        "missing_authority": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "bestiaryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "entry_status",
        "mvp_phase",
        "rules_basis",
        "creature_profile",
        "planned_capabilities",
        "open_mechanics",
        "fixture_path",
        "lore_boundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^B06-EN-[0-9]{2}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entry_status": {
          "enum": [
            "EXECUTABLE_FIXTURE_EXISTS",
            "CONCEPT_ONLY",
            "DEFERRED"
          ]
        },
        "mvp_phase": {
          "enum": [
            "B06_A",
            "B06_LATER",
            "POST_MVP"
          ]
        },
        "rules_basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "creature_profile": {
          "$ref": "#/$defs/creatureProfile"
        },
        "planned_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plannedCapability"
          }
        },
        "open_mechanics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixture_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "lore_boundary": {
          "type": "string"
        },
        "encounter_guidance": {
          "$ref": "#/$defs/encounterGuidance"
        }
      }
    },
    "encounterGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combat_role",
        "challenge_rating",
        "frequency_contexts",
        "test_scenarios",
        "notes"
      ],
      "properties": {
        "combat_role": {
          "enum": [
            "ordinary_humanoid",
            "specialist_humanoid",
            "elite_ambush_predator",
            "boss",
            "noncombat",
            "unrated"
          ],
          "description": "Encounter identity only, never a numerical defense or damage grant."
        },
        "challenge_rating": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "value",
            "scale",
            "reference_setup"
          ],
          "properties": {
            "status": {
              "enum": [
                "unrated",
                "provisional",
                "calibrated"
              ]
            },
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "scale": {
              "type": [
                "string",
                "null"
              ]
            },
            "reference_setup": {
              "type": "string",
              "minLength": 1
            },
            "calibration_evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Source links/encounter logs required when declaring a rating calibrated. Optional for unrated/provisional records."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unrated"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  },
                  "scale": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "provisional",
                      "calibrated"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 0
                  },
                  "scale": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "calibrated"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "required": [
                  "calibration_evidence"
                ]
              }
            }
          ],
          "description": "No numeric rating without explicit scale and reference. Status unrated means null value/scale."
        },
        "frequency_contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "context",
              "frequency_assessment",
              "contact_may_be_nonhostile",
              "notes"
            ],
            "properties": {
              "context": {
                "type": "string",
                "minLength": 1
              },
              "frequency_assessment": {
                "enum": [
                  "unquantified",
                  "regular",
                  "situational",
                  "rare"
                ]
              },
              "contact_may_be_nonhostile": {
                "type": "boolean"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "test_scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "party_size_min",
              "party_size_max",
              "party_level_min",
              "party_level_max",
              "enemy_count",
              "intended_difficulty",
              "setup",
              "evidence_status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^B06-SC-[A-Z0-9-]+$"
              },
              "party_size_min": {
                "type": "integer",
                "minimum": 1
              },
              "party_size_max": {
                "type": "integer",
                "minimum": 1
              },
              "party_level_min": {
                "type": "integer",
                "minimum": 1
              },
              "party_level_max": {
                "type": "integer",
                "minimum": 1
              },
              "enemy_count": {
                "type": "integer",
                "minimum": 0
              },
              "intended_difficulty": {
                "enum": [
                  "noncombat",
                  "routine",
                  "standard",
                  "dangerous",
                  "severe",
                  "unrated"
                ]
              },
              "setup": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "enum": [
                  "untested",
                  "observed",
                  "calibrated"
                ]
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "B06 provisional assessment fields distinguish frequency, intrinsic CR, per-scenario party/number and intended difficulty. A scenario tag is NOT a verified balance claim."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "type": {
                "const": "player_rules_derived_opponent"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "identity"
        ]
      },
      "then": {
        "required": [
          "progression"
        ]
      },
      "else": {
        "required": [
          "creature_profile"
        ]
      }
    }
  ]
}
