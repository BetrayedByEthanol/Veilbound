{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veilbound.local/schemas/technique.schema.json",
  "title": "Veilbound Technique",
  "type": "object",
  "required": ["id", "name", "aspectId", "tier", "status", "action", "cadence"],
  "properties": {
    "id": {"type": "string", "pattern": "^technique\\.[a-z0-9.-]+$"},
    "name": {"type": "string", "minLength": 1},
    "aspectId": {"type": "string", "pattern": "^aspect\\.[a-z0-9.-]+$"},
    "tier": {"type": "integer", "minimum": 0, "maximum": 9},
    "status": {"enum": ["locked", "provisional"]},
    "action": {"enum": ["attack-unit", "full-action", "reaction", "sustained", "other"]},
    "cadence": {
      "type": "array",
      "items": {"enum": ["continuous", "rider", "pulse", "spend"]},
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "enum": [
          "projection",
          "embodiment",
          "inward",
          "consecration",
          "devotional-rite",
          "investment-compatible"
        ]
      },
      "uniqueItems": true
    },
    "vpCost": {"type": ["integer", "null"], "minimum": 0},
    "text": {"type": "string"}
  },
  "additionalProperties": false
}
